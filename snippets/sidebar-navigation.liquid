<ul class="sidebar__menu sidebar--{{ type }}">

	{% for link in menu.links %}

		{%- assign link_url = link.url | remove: 'https://www.constance.website' | remove: 'https://yoon-world.myshopify.com' -%}
		{%- if link_url == blank -%}{%- assign link_url = '/' -%}{%- endif -%}
		{%- assign has_submenu = false -%}
		{%- if link.links != blank or link.handle == 'rental' -%}{%- assign has_submenu = true -%}{%- endif -%}

		<li class="{% if has_submenu %} has-submenu has-first-submenu {% endif %}{% if link.title == 'Q&A' or link.title == 'q&a' or link.handle == 'q-a' or link.handle == 'qanda' or link.title == 'ABOUT' or link.title == 'about' or link.handle == 'about' %} sidebar__spacer-before {% endif %}" {% if has_submenu %} aria-haspopup="true" {% endif %}>

			<a href="{{ link_url }}"  class="{% if has_submenu %} parent-has-submenu {% endif %}{% if link.active or link.child_active %} selected {% endif %}" data-type="{{ type }}">
				<span style="flex: 1;"><span class="underline-animation">{% if link.handle == 'shop' %}SHOP{% else %}{{ link.title | escape }}{% endif %}</span></span>
				<span aria-hidden="true">{% if has_submenu %} {% render 'theme-symbols', icon: 'arrow' %} {% endif %}</span>
			</a>

			{% if has_submenu %}

				<div data-handle="{{ link.handle }}" class="sidebar__submenu sidebar__submenu--first sidebar--{{ type }}" aria-expanded="false">

					<div class="sidebar__container">

						<div class="sub-menu sub-menu--second">

							<ul>

								{%- if link.handle == 'shop' -%}

									<li><a href="/collections/all" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">all</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/new-arrivals/yellow" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">new arrival</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/chairs" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">sittings</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/tables" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">tables</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/desks" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">desks</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/lighting" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">lighting</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/storage" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">storage</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/cart/cart" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">carts</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/outdoor" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">outdoor</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/accessory" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">objects</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/audio" class="sub-menu__link-second sub-menu__last-second"><span style="flex: 1;"><span class="underline-animation">audio</span></span><span aria-hidden="true"></span></a></li>

								{%- elsif link.handle == 'rental' -%}

									<li><a href="/collections/rental" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">all</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/chairs" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">sittings</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/tables" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">tables</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/desks" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">desks</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/lighting" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">lighting</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/storage" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">storage</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/cart" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">carts</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/outdoor" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">outdoor</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/accessory" class="sub-menu__link-second"><span style="flex: 1;"><span class="underline-animation">objects</span></span><span aria-hidden="true"></span></a></li>
									<li><a href="/collections/rental/audio" class="sub-menu__link-second sub-menu__last-second"><span style="flex: 1;"><span class="underline-animation">audio</span></span><span aria-hidden="true"></span></a></li>

								{%- else -%}

									{% for childlink in link.links %}

										{%- assign childlink_url = childlink.url | remove: 'https://www.constance.website' | remove: 'https://yoon-world.myshopify.com' -%}
										{%- if childlink_url == blank -%}{%- assign childlink_url = '/' -%}{%- endif -%}

										<li class="{% if childlink.links != blank %} has-submenu has-second-submenu {% endif %}" {% if childlink.links != blank %} aria-haspopup="true" {% endif %}>

											<a href="{{ childlink_url }}" class="{% if childlink.links != blank %} parent-has-submenu {% endif %} sub-menu__link-second{% if childlink.active or childlink.child_active %} selected {% endif %} {% if forloop.last %} sub-menu__last-second {% endif %}">
												<span style="flex: 1;"><span class="underline-animation">{{ childlink.title | escape }}</span></span>
												<span aria-hidden="true">{% if childlink.links != blank %} {% render 'theme-symbols', icon: 'arrow' %} {% endif %}</span>
											</a>

											{% if childlink.links != blank %}

												<div data-handle="{{ childlink.handle }}" class="sidebar__submenu sidebar__submenu--second sidebar--{{ type }}" aria-expanded="false">

													<div class="sidebar__container">

														<div class="sub-menu">

															<ul>

																{% for subchildlink in childlink.links %}

																	{%- assign subchildlink_url = subchildlink.url | remove: 'https://www.constance.website' | remove: 'https://yoon-world.myshopify.com' -%}
																	{%- if subchildlink_url == blank -%}{%- assign subchildlink_url = '/' -%}{%- endif -%}

																	<li>
																		<a href="{{ subchildlink_url }}" class="sub-menu__link-third{% if subchildlink.active %} selected {% endif %} {% if forloop.last %} sub-menu__last-third {% endif %}"><span class="underline-animation">{{ subchildlink.title | escape }}</span></a>
																	</li>

																{% endfor %}

															</ul>

														</div>

													</div>

												</div>

											{% endif %}

										</li>

									{% endfor %}

								{%- endif -%}

							</ul>

						</div>

					</div>

				</div>

			{% endif %}

		</li>


	{% endfor %}

</ul>

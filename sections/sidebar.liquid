<div class="sidebar">

	<div class="sidebar__container sidebar__responsive-container">

		<div class="sidebar__container-holder" style="flex: 1 0 auto;">

		<div class="sidebar__topbar">

			<header class="logo">

				{%- if template == 'index' -%}
					<h1>
				{%- else -%}
					<div>
				{%- endif -%}

					{%- if section.settings.logo_src -%}

						<a class="logo__image" href="{{ routes.root_url }}">
							<img src="{{ section.settings.logo_src | img_url: 'master' }}" alt="{{ shop.name | escape }}" style="max-width: {{ section.settings.logo_width | escape }}px;" width="{{ section.settings.logo_src.width }}" height="{{ section.settings.logo_src.height }}" />
						</a>

					{%- else -%}

						<a class="logo__text" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

					{%- endif -%}

				{%- if template == 'index' -%}
					</h1>
				{%- else -%}
					</div>
				{%- endif -%}

			</header>

			<div class="sidebar__topbar-right">

				{%- if section.settings.show_search -%}
					<span class="sidebar__search-handle">
						<span class="icon icon-search" aria-hidden="true">{%- render 'theme-symbols', icon: 'search' -%}</span>
					</span>
				{%- endif -%}

				<span class="sidebar__menu-handle">
					<span class="icon icon-menu" aria-hidden="true">{% render 'theme-symbols', icon: 'burger' %}</span>
				</span>

			</div>

		</div>

		<div class="sidebar__responsive-handles" style="display:none;"></div>

	    <div class="sidebar__menus {% if section.settings.show_search %} search-bottom-padding {% endif %}">

				<span class="sidebar__menus-close hidden" tabindex="0">
					<span class="visually-hidden">{{ 'general.accessibility_labels.close' | t }}</span>
					<span aria-hidden="true">{%- render 'theme-symbols', icon: 'close' -%}</span>
				</span>

				<span class="sidebar__menus-back hidden" tabindex="0">
					<span class="visually-hidden">{{ 'general.accessibility_labels.back' | t }}</span>
					<span aria-hidden="true">{% render 'theme-symbols', icon: 'arrow-left' %}</span>
				</span>

			{%- if section.settings.show_search -%}
				<div class="sidebar__inline-search">
					<form action="{{ routes.search_url }}" method="get">
						<input type="hidden" name="type" value="product">
						<input type="text" name="q" placeholder="Search..." class="sidebar__inline-search-input" autocomplete="off">
					</form>
				</div>
			{%- endif -%}

			<div class="sidebar__below-search">
			{%- if shop.customer_accounts_enabled -%}
				<ul class="sidebar__menu sidebar__account-top">
					{%- unless customer -%}
					<li>
						<a href="{{ routes.account_login_url }}"><span class="underline-animation">login</span></a>
					</li>
					{%- endunless -%}
					<li>
						<a href="{{ routes.account_url }}"><span class="underline-animation">my account</span></a>
					</li>
				</ul>
			{%- endif -%}

		    <nav class="primary-menu">
					{%- render 'sidebar-navigation', menu: menus[section.settings.menu_primary], type: 'primary' -%}
	    	</nav>

			{%- assign instagram_url = '' -%}
			{%- for link in menus[section.settings.menu_secondary].links -%}
				{%- if link.url contains 'instagram' -%}
					{%- assign instagram_url = link.url -%}
				{%- endif -%}
			{%- endfor -%}

	    	<nav class="secondary-menu">

					{%- render 'sidebar-navigation', menu: menus[section.settings.menu_secondary], type: 'secondary' -%}



					<div class="localization-form-holder">
			      {%- render 'localization-form', location: 'sidebar', show_currency_selector: section.settings.show_currency_selector, show_locale_selector: section.settings.show_locale_selector -%}
			    </div>

					<div class="sidebar__social">
						{%- if instagram_url != '' -%}
							<a href="{{ instagram_url }}" class="sidebar__social-link" target="_blank" rel="noopener" aria-label="Instagram">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="5" stroke="#000" stroke-width="1.8"/><circle cx="12" cy="12" r="4.5" stroke="#000" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1" fill="#000"/></svg>
							</a>
						{%- endif -%}
						<a href="mailto:#" class="sidebar__social-link" aria-label="Email">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="3" width="20" height="18" rx="3" stroke="#000" stroke-width="1.8"/><path d="M2 8l10 7 10-7" stroke="#000" stroke-width="1.8" stroke-linecap="round"/></svg>
						</a>
					</div>

	    	</nav>

			</div><!-- sidebar__below-search -->

	    </div>
			
			{%- unless template contains 'cart' -%}
				<div class="sidebar__cart">
					<div>
						<span class="sidebar__cart-close" tabindex="0">
							<span class="visually-hidden">{{ 'general.accessibility_labels.close' | t }}</span>
							<span aria-hidden="true">{%- render 'theme-symbols', icon: 'close' -%}</span>
						</span>
						{%- render 'cart-form', location: 'sidebar' -%}
					</div>
				</div>
			{%- endunless -%}


		</div>
	</div>

	<div class="sidebar__seconds"><div><div class="sidebar__menu"></div></div></div>
	<div class="sidebar__thirds"><div><div class="sidebar__menu"></div></div></div>

</div>

<style>
	.sidebar__container-holder {
		margin-top: 0 !important;
	}
	.sidebar__topbar {
		display: none !important;
	}
	.sidebar__menus {
		padding-top: 16px !important;
	}
	.sidebar__inline-search {
		padding: 4px 14% 8px;
	}
	.sidebar__inline-search-input {
		width: 100%;
		border: none;
		border-bottom: 1px solid #000;
		background: transparent;
		font-size: 0.85em;
		padding: 2px 0 1px;
		outline: none;
		font-family: inherit;
		letter-spacing: 0.04em;
	}
	.sidebar__below-search {
		margin-top: 40px;
	}
	.sidebar__topbar .logo {
		margin: 0 !important;
		padding: 0 !important;
		flex-shrink: 0;
	}
	.sidebar__topbar .logo h1,
	.sidebar__topbar .logo div {
		margin: 0 !important;
		padding: 0 !important;
		font-size: inherit !important;
		font-weight: inherit !important;
		line-height: inherit !important;
	}
	.sidebar__topbar .logo img {
		max-width: 220px !important;
		max-height: none !important;
	}
	.sidebar__topbar .logo {
		display: none !important;
	}
	.sub-menu__link-second {
		transition: font-size 0.2s ease, letter-spacing 0.2s ease;
	}
	.sub-menu__link-second:hover {
		font-size: 1.25em !important;
		letter-spacing: 0.08em;
	}
	.sidebar__account-top {
		padding-top: 32px !important;
		padding-bottom: 0 !important;
		margin-bottom: 0 !important;
	}
	.sidebar__account-top li a {
		font-size: 0.8em;
		letter-spacing: 0.04em;
	}
	.sidebar__topbar .logo__text {
		font-size: 3em !important;
	}
	.sidebar__topbar-right {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
		margin-left: auto;
	}
	.sidebar__cart-top {
		display: flex;
		align-items: center;
		position: relative;
		text-decoration: none;
		color: inherit;
	}
	.sidebar__cart-top .icon-cart svg {
		width: 22px;
		height: 22px;
	}
	.sidebar__cart-top-count {
		position: absolute;
		top: -6px;
		right: -8px;
		font-size: 0.65em;
		opacity: 0.8;
	}
	/* 필터 버튼 숨김 — 나중에 이 줄 삭제하면 다시 보임 */
	.collection-filters-handle-holder { display: none !important; }
	/* 인스타 텍스트 메뉴 숨김 */
	.sidebar--secondary a[href*="instagram"] { display: none !important; }
	.sidebar__spacer-before > a { margin-top: 20px; }
	.sidebar__social {
		display: flex;
		gap: 16px;
		padding: 20px 14% 8px;
	}
	.sidebar__social-link {
		color: #000;
		opacity: 1;
		transition: opacity 0.2s;
		display: flex;
		align-items: center;
	}
	.sidebar__social-link:hover {
		opacity: 0.6;
	}
	.sidebar__seconds .sub-menu {
		padding-top: var(--rental-sub-top, 278px) !important;
	}
</style>

<script>
(function() {
    function updateSubTop() {
        var rentalLi = null;
        var items = document.querySelectorAll('.sidebar__menu.sidebar--primary li.has-first-submenu');
        for (var i = 0; i < items.length; i++) {
            if (items[i].querySelector('[data-handle="rental"]')) {
                rentalLi = items[i];
                break;
            }
        }
        if (!rentalLi) return;
        var top = rentalLi.getBoundingClientRect().top;
        if (top > 10) {
            document.documentElement.style.setProperty('--rental-sub-top', top + 'px');
        }
    }
    window.addEventListener('load', function() {
        requestAnimationFrame(updateSubTop);
    });
    window.addEventListener('resize', updateSubTop);
})();
</script>

{% schema %}
  {
    "name": "Sidebar",
    "class": "mount-sidebar mount-overlay",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_src",
        "label": "Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Custom logo width (in pixels)",
        "min": 50,
        "max": 250,
        "step": 2,
        "default": 100
      },
      {
        "type": "link_list",
        "id": "menu_primary",
        "label": "Primary navigation",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "menu_secondary",
        "label": "Secondary navigation",
	      "info": "This menu won't show dropdown items"
      },
      {
        "type": "header",
        "content": "Language Selector",
        "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
      },
      {
        "type": "checkbox",
        "id": "show_locale_selector",
        "label": "Show language selector",
        "default": false
      },
      {
        "type": "header",
        "content": "Currency Selector",
        "info": "To add a currency, go to your [payment settings.](/admin/settings/payments)"
      },
      {
        "type": "checkbox",
        "id": "show_currency_selector",
        "label": "Show currency selector",
        "default": false
      },
      {
        "type": "header",
        "content": "Search"
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "Show search",
        "default": true
      }
    ]
  }
{% endschema %}
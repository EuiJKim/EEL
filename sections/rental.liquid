<div class="rental">

  {%- if section.settings.title != blank -%}
    <h2 class="rental__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- if section.settings.description != blank -%}
    <div class="rental__description rte">{{ section.settings.description }}</div>
  {%- endif -%}

  <div class="rental__items">

    {% for block in section.blocks %}

      <div class="rental__item" {{ block.shopify_attributes }}>

        {%- if block.settings.image != blank -%}
          <div class="rental__item-image">
            {%- render 'lazy-image', image: block.settings.image, type: 'image' -%}
          </div>
        {%- endif -%}

        <div class="rental__item-info">

          {%- if block.settings.name != blank -%}
            <h3 class="rental__item-name">{{ block.settings.name | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.details != blank -%}
            <div class="rental__item-details rte">{{ block.settings.details }}</div>
          {%- endif -%}

          {%- if block.settings.price != blank -%}
            <p class="rental__item-price">{{ block.settings.price | escape }}</p>
          {%- endif -%}

        </div>

      </div>

    {% endfor %}

  </div>

  {%- if section.settings.contact_text != blank or section.settings.contact_url != blank -%}
    <div class="rental__contact">
      <a href="{{ section.settings.contact_url }}" class="btn">{{ section.settings.contact_text | escape }}</a>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Rental",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "빈티지 가구 렌탈"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>촬영을 위한 빈티지 가구 렌탈 서비스입니다. 원하시는 가구를 선택하시고 문의해 주세요.</p>"
    },
    {
      "type": "header",
      "content": "Contact Button"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Button Text",
      "default": "렌탈 문의하기"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Rental Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Item Name",
          "default": "빈티지 체어"
        },
        {
          "type": "richtext",
          "id": "details",
          "label": "Details",
          "default": "<p>사이즈, 소재 등 상세 정보를 입력하세요.</p>"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Rental Price",
          "default": "1일 ₩30,000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rental",
      "blocks": [
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}

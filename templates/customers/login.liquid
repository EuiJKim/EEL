<div class="page-content">

	{% render 'form-errors', form: form %}

	{% form 'customer_login' %}

		<h1 class="title h0" style="text-align:center;">{{ 'customers.login_page.title' | t }}</h1>

		<div class="login-form-wrap">

			{% render 'form-errors', form: form %}

			<div>
				<label for="customer_email" class="hidden">{{ 'customers.login_page.form_email_label' | t }}</label>
				<input type="email" value="" name="customer[email]" id="customer_email" placeholder="{{ 'customers.login_page.form_email_label' | t }}" {% if form.errors contains "email" %} class="error"{% endif %} autocorrect="off" autocapitalize="off" autofocus>
			</div>

			{% if form.password_needed %}
				<div>
					<label for="customer_password" class="hidden">{{ 'customers.login_page.form_password_label' | t }}</label>
					<input type="password" value="" name="customer[password]" id="customer_password" placeholder="{{ 'customers.login_page.form_password_label' | t }}" {% if form.errors contains "password" %} class="error"{% endif %}>
				</div>
			{% endif %}

			<div class="login-actions">

				<input type="submit" class="button button--solid button--wide" value="{{ 'customers.login_page.form_login_button' | t }}">

				<div class="login-actions__links">
					{% if form.password_needed %}
						<a href="#recover" onclick="showRecoverPasswordForm();return false;" class="login-actions__link">{{ 'customers.login_page.forgot_password_check' | t }}</a>
					{% endif %}
					<a href="/account/register" class="login-actions__link login-actions__link--signup">{{ 'customers.login_page.new_customer_button' | t }}</a>
				</div>

			</div>

		</div>

	{% endform %}

	<div class="social-login">

		<div class="social-login__divider">
			<span>또는</span>
		</div>

		<div class="social-login__buttons">

			<a href="#kakao-login" class="social-login__btn social-login__btn--kakao">
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M10 2C5.582 2 2 4.91 2 8.5c0 2.278 1.388 4.282 3.5 5.478L4.625 17.5l3.868-2.558C8.994 15 9.492 15 10 15c4.418 0 8-2.91 8-6.5S14.418 2 10 2z" fill="#3A1D1D"/>
				</svg>
				카카오로 시작하기
			</a>

			<a href="#naver-login" class="social-login__btn social-login__btn--naver">
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M11.4 10.32L8.52 6H6v8h2.6V9.68L11.48 14H14V6h-2.6v4.32z" fill="white"/>
				</svg>
				네이버로 시작하기
			</a>

		</div>

	</div>

	<style>
		.login-form-wrap {
			max-width: 360px;
			margin: 0 auto;
		}
		.login-form-wrap input[type="email"],
		.login-form-wrap input[type="password"] {
			width: 100%;
			box-sizing: border-box;
		}
		.login-form-wrap .login-actions {
			display: flex;
			flex-direction: column;
			gap: 14px;
			margin-top: 4px;
		}
		.login-form-wrap .button--wide {
			width: 100%;
			box-sizing: border-box;
			margin: 0;
		}
		.login-actions__links {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 6px;
		}
		.login-actions__link {
			font-size: 12px;
			color: #888;
			text-decoration: none;
		}
		.login-actions__link:hover {
			color: #333;
		}
		.login-actions__link--signup {
			font-weight: 600;
			color: #333;
		}
		.social-login {
			margin-top: 28px;
			max-width: 360px;
			margin-left: auto;
			margin-right: auto;
		}
		.social-login__divider {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 20px;
			color: #999;
			font-size: 13px;
		}
		.social-login__divider::before,
		.social-login__divider::after {
			content: '';
			flex: 1;
			height: 1px;
			background: #e0e0e0;
		}
		.social-login__buttons {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		.social-login__btn {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			width: 100%;
			padding: 13px 20px;
			border-radius: 4px;
			font-size: 14px;
			font-weight: 600;
			text-decoration: none;
			cursor: pointer;
			transition: opacity 0.15s ease;
		}
		.social-login__btn:hover {
			opacity: 0.88;
			text-decoration: none;
		}
		.social-login__btn--kakao {
			background-color: #FEE500;
			color: #3A1D1D;
		}
		.social-login__btn--naver {
			background-color: #03C75A;
			color: #fff;
		}
	</style>

	<div class="alert alert--success" id="resetSuccess" style="display:none;">{{ 'customers.login_page.password_reset.success_message' | t }}</div>

	<div id="recover_password" style="display: none;">

		<h3 class="title h0">{{ 'customers.login_page.password_reset.title' | t }}</h3>
		<p class="subtitle">{{ 'customers.login_page.password_reset.subtitle' | t }}</p>

		{% form 'recover_customer_password' %}

			<div class="krown-columns-container one-whole">

				{% render 'form-errors', form: form %}

				{% if form.posted_successfully? %}
					{% assign reset_success = true %}
				{% endif %}

      	<div class="krown-column-container one-whole first last">
					<label for="recover-email" class="hidden">{{ 'customers.login_page.password_reset.email_label' | t }}</label>
					<input type="email" value="" name="email" id="recover-email" placeholder="{{ 'customers.login_page.password_reset.email_label' | t }}" autocorrect="off" autocapitalize="off">
				</div>

				<div class="login-actions">

					<input type="submit" class="button button--solid button--wide" value="{{ 'customers.login_page.password_reset.submit_button' | t }}">

					<div><a href="#" onclick="hideRecoverPasswordForm();return false;">{{ 'customers.login_page.password_reset.cancel_button' | t }}</a></div>

				</div>

			</div>

		{% endform %}

	</div>

	{% if shop.checkout.guest_login %}

		<h3 class="title h0" style="margin-top: 2em;">{{ 'customers.login_page.guest_check' | t }}</h3>

		{% form 'guest_login' %}
			<input type="submit" class="button button--solid button--wide" value="{{ 'customers.login_page.guest_button' | t }}">
		{% endform %}
		
	{% endif %}

</div>

<script>

	function showRecoverPasswordForm() {
		document.getElementById('recover_password').style.display = 'block';
		document.getElementById('customer_login').style.display='none';
	}

	function hideRecoverPasswordForm() {
		document.getElementById('recover_password').style.display = 'none';
		document.getElementById('customer_login').style.display = 'block';
	}

	if (window.location.hash == '#recover') { showRecoverPasswordForm() }

</script>

{% if reset_success %}
  <style type="text/css">
    #resetSuccess { 
      display: block !important;
      margin-top: 25px;
    }
  </style>
{% endif %}
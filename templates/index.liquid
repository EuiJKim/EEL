<div id="rental-banner" class="rental-banner">
	<span class="rental-banner__text">
		첫 렌탈 <strong>10% 할인</strong> — 지금 문의하고 특별 혜택을 받아보세요.
	</span>
	<button class="rental-banner__close" onclick="dismissBanner()" aria-label="닫기">✕</button>
</div>

<div class="content-section gutter--on" style="padding-top: 48px;">
	<div class="collection collection--grid mount-collection" style="grid-template-columns: 1fr 1fr 1fr 1fr; display: grid; gap: 25px;">
		{%- for product in collections.all.products -%}
			{%- unless product.id == 8159765201066 -%}
				{%- render 'product-item', product: product -%}
			{%- endunless -%}
		{%- endfor -%}
	</div>
</div>

<style>
	.rental-banner {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		background-color: #1a1a1a;
		color: #fff;
		padding: 14px 48px;
		font-size: 0.85em;
		letter-spacing: 0.04em;
		text-align: center;
	}
	.rental-banner__text strong {
		font-weight: 700;
	}
	.rental-banner__close {
		position: absolute;
		right: 16px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: #fff;
		font-size: 14px;
		cursor: pointer;
		opacity: 0.6;
		padding: 4px 8px;
		line-height: 1;
	}
	.rental-banner__close:hover {
		opacity: 1;
	}
	.template-index .product-item__thumbnail {
		padding-top: 100% !important;
	}
	.template-index .product-item__badge span {
		font-family: var(--font-stack-headings) !important;
		font-weight: 600;
		font-size: 1.15em;
		letter-spacing: 0.06em;
		font-style: italic;
	}
</style>

<script>
	if (localStorage.getItem('rentalBannerDismissed') === '1') {
		var banner = document.getElementById('rental-banner');
		if (banner) { banner.style.opacity = '0'; banner.style.pointerEvents = 'none'; }
	}

	function dismissBanner() {
		var banner = document.getElementById('rental-banner');
		banner.style.transition = 'opacity 0.3s ease';
		banner.style.opacity = '0';
		banner.style.pointerEvents = 'none';
		localStorage.setItem('rentalBannerDismissed', '1');
	}
</script>
